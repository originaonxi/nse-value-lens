//@version=6
// Nifty 50 best setup - EMA 21 / EMA 105 on 15-minute candles.
// BUY when EMA 21 is above EMA 105 at a candle close.
// SELL (short) when EMA 21 is below EMA 105.
// Orders fill at the next candle's open. Always in a trade.
// No target, no extra stop. 1 lot = 65. Cost 0.035% per side.
// Test 3 Jul 2023 - 9 Nov 2026: +7,512 points after costs.
// Source: originaonxi.github.io/nse-value-lens/best15.html
strategy("Nifty EMA 21/105 15m", "EMA 21/105 15m",
      overlay = true,
      initial_capital = 10000000,
      default_qty_type = strategy.fixed,
      default_qty_value = 65,
      commission_type = strategy.commission.percent,
      commission_value = 0.035,
      process_orders_on_close = false,
      pyramiding = 0)

mode = input.string("Always in", "Mode",
      options = ["Always in", "BUY or WATCH", "SELL or WATCH"])
fastLen = input.int(21, "Fast EMA", minval = 1)
slowLen = input.int(105, "Slow EMA", minval = 2)
startAt = input.time(timestamp("03 Jul 2023 00:00 +0530"),
      "Start trading from")

fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
ready = bar_index >= slowLen and time >= startAt
up = fastEma > slowEma
goUp = ready and up and not up[1]
goDown = ready and not up and up[1]

longOk = mode != "SELL or WATCH"
shortOk = mode != "BUY or WATCH"

if ready and up and strategy.position_size <= 0
    if longOk
        strategy.entry("BUY", strategy.long, comment = "BUY")
    else
        strategy.close("SELL", comment = "COVER")
if ready and not up and strategy.position_size >= 0
    if shortOk
        strategy.entry("SELL", strategy.short, comment = "SELL")
    else
        strategy.close("BUY", comment = "EXIT")

// Next 15-min close that would put EMA 21 exactly on EMA 105.
a = 2.0 / (fastLen + 1)
b = 2.0 / (slowLen + 1)
flipAt = ((1 - b) * slowEma - (1 - a) * fastEma) / (a - b)

upFill = color.new(color.green, 85)
dnFill = color.new(color.red, 85)
pf = plot(fastEma, "EMA 21", color = color.orange, linewidth = 2)
ps = plot(slowEma, "EMA 105", color = color.purple, linewidth = 2)
fill(pf, ps, color = up ? upFill : dnFill, title = "Trend")
plotshape(goUp, "BUY", shape.labelup, location.belowbar,
      color.green, text = "BUY", textcolor = color.white,
      size = size.small)
plotshape(goDown, "SELL", shape.labeldown, location.abovebar,
      color.red, text = "SELL", textcolor = color.white,
      size = size.small)

// ---- check panel ----
var int firstTime = time
lotPts = 65 * syminfo.pointvalue
pnl = strategy.netprofit + strategy.openprofit
totalPts = pnl / lotPts
closedN = strategy.closedtrades
winPct = closedN > 0 ? 100.0 * strategy.wintrades / closedN : 0.0
pos = strategy.position_size
entryPx = pos != 0 ? strategy.opentrades.entry_price(0) : na
posTxt = pos > 0 ? "LONG" : pos < 0 ? "SHORT" : "WATCH"
if pos != 0
    posTxt := posTxt + " since " + str.tostring(entryPx, "#.##")
posCol = pos > 0 ? color.green : pos < 0 ? color.red : color.gray
flipTxt = up ? "Flips to SELL below" : "Flips to BUY above"
is15 = timeframe.period == "15"
tfTxt = is15 ? "15 min (tested)" : "NOT 15 min - untested"
trendTxt = up ? "UP - BUY side" : "DOWN - SELL side"
ptsTxt = str.tostring(totalPts, "#,##0.0")
wonTxt = str.tostring(winPct, "0.0") + "%"
tradesTxt = str.tostring(closedN) + " / " + wonTxt
firstTxt = str.format_time(firstTime, "dd MMM yyyy", "Asia/Kolkata")

row(t, r, label, txt, col) =>
    table.cell(t, 0, r, label, text_color = color.gray)
    table.cell(t, 1, r, txt, text_color = col)

var table tb = table.new(position.top_right, 2, 9,
      bgcolor = color.white, border_width = 1,
      border_color = color.new(color.gray, 70))
if barstate.islast
    row(tb, 0, "EMA 21", str.tostring(fastEma, "#.##"), color.orange)
    row(tb, 1, "EMA 105", str.tostring(slowEma, "#.##"), color.purple)
    row(tb, 2, "Trend", trendTxt, up ? color.green : color.red)
    row(tb, 3, "Position", posTxt, posCol)
    row(tb, 4, flipTxt, str.tostring(flipAt, "#.##"), color.gray)
    row(tb, 5, "Points since start", ptsTxt,
          totalPts >= 0 ? color.green : color.red)
    row(tb, 6, "Closed trades / won", tradesTxt, color.gray)
    row(tb, 7, "First candle on chart", firstTxt, color.gray)
    row(tb, 8, "Chart", tfTxt, is15 ? color.green : color.orange)

// ---- alerts: Alert > Condition "EMA 21/105 15m" > any alert() ----
msgUp = "Nifty EMA 21/105: BUY at next 15m open. Close "
msgDn = "Nifty EMA 21/105: SELL at next 15m open. Close "
once = alert.freq_once_per_bar_close
if goUp
    alert(msgUp + str.tostring(close, "#.##"), once)
if goDown
    alert(msgDn + str.tostring(close, "#.##"), once)
